# Tendrils SEO Crawler: backend configuration.
# Copy this file to `.env` (same folder as app.py) and fill in the values.
# `.env` is git-ignored and is never packaged. Never commit real keys.

# Required. Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Required. Any Groq chat model id from https://console.groq.com/docs/models
# Change it any time and restart the app; no code changes needed.
GROQ_MODEL=your_supported_groq_model

# Optional tuning (defaults shown; remove the leading # to override)
# GROQ_TIMEOUT_SECONDS=45
# GROQ_MAX_RETRIES=2
# GROQ_MAX_OUTPUT_TOKENS=1800
# GROQ_CONTEXT_TOKEN_BUDGET=5000
# GROQ_MAX_RETRY_WAIT_SECONDS=20
