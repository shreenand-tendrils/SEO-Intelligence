# Copy to .env (never commit .env).
POSTGRES_DB=seo
POSTGRES_USER=seo
POSTGRES_PASSWORD=change-me
# Shared secret between backend and crawler (any long random string).
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
# Groq (crawler service only; never sent to the browser).
GROQ_API_KEY=
GROQ_MODEL=
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080
# Folder with the old ~/.site-crawler-crawls data to import (mounted read-only).
LEGACY_DATA_DIR=./infra/empty-legacy
# Build the crawler image with Playwright + Chromium for JS rendering (large).
INSTALL_PLAYWRIGHT=false
