{
  "name": "tendrils-seo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "import:legacy": "node src/scripts/importLegacy.js",
    "rescore": "node src/scripts/rescore.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/*.integration.test.js\"",
    "test:e2e": "node --test test/e2e.crawler.js",
    "test:unit": "node --test test/scoring.test.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "compression": "1.7.5",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
