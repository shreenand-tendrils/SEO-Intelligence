# Copy to backend/.env for local (non-Docker) runs. Never commit .env.
DATABASE_URL=postgresql://seo:seo@localhost:5432/seo?schema=public
PORT=4000
CRAWLER_INTERNAL_URL=http://127.0.0.1:5002
# Must match INTERNAL_API_TOKEN in the crawler's environment.
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
# Optional: where the old ~/.site-crawler-crawls data lives (import only).
# LEGACY_DATA_DIR=C:\Users\you\.site-crawler-crawls
